# Use the official Node.js image
FROM node:26-bookworm

# Install ffmpeg
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

# Create and change to the app directory
WORKDIR /usr/src/app

# Copy package.json and package-lock.json
COPY src/recorder/package*.json ./

# Install dependencies
RUN npm install

# Copy the recorder script
COPY src/recorder/recorder.js ./
COPY src/recorder/time-helpers.js ./
COPY src/recorder/streams-db.js ./

# Ensure the audio directory exists
RUN mkdir -p /usr/src/app/audio

# Command to run the recorder script
CMD ["node", "recorder.js"]
