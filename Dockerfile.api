# Use the official Node.js image
FROM node:26-bookworm

# Create and change to the app directory
WORKDIR /usr/src/app

# Install ffmpeg (fluent-ffmpeg in routes/util.js shells out to it) plus the
# build toolchain (python3 make g++) needed to compile the argon2 native addon
# during `npm ci` (the api uses the built-in node:sqlite, not better-sqlite3).
RUN apt-get update && apt-get install -y ffmpeg python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package.json + lockfile and install the exact locked dependencies
COPY src/api/package*.json ./

RUN npm ci

# Copy the API application code
COPY src/api/ .

# Internal-only port; nginx reverse-proxies to it. Not published to the host.
EXPOSE 3000

# Command to run the API service
CMD ["node", "index.js"]
