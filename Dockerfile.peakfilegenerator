# Use the official Node.js 26 image on Debian 12 (bookworm)
FROM node:26-bookworm

# Install audiowaveform from the BBC bookworm/amd64 .deb.
# Installing the .deb by path lets apt resolve and pull its runtime dependencies.
RUN apt-get update && \
    apt-get install -y curl && \
    curl -fsSL -o /tmp/aw.deb https://github.com/bbc/audiowaveform/releases/download/1.10.2/audiowaveform_1.10.2-1-12_amd64.deb && \
    apt-get install -y /tmp/aw.deb && \
    rm -f /tmp/aw.deb && \
    rm -rf /var/lib/apt/lists/*

# Create and change to the app directory
WORKDIR /usr/src/app

# Copy package.json and package-lock.json from the peakfilegenerator directory
COPY src/peakfilegenerator/package*.json ./

# Install Node.js dependencies
RUN npm install

# Copy the peakfilegenerator script
COPY src/peakfilegenerator/peakfilegenerator.js ./

# Ensure the audio directory exists
RUN mkdir -p /usr/src/app/audio

# Command to run the peakfilegenerator script
CMD ["node", "peakfilegenerator.js"]
