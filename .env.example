# Host port the frontend (nginx) is published on. Compose falls back to 9703 if unset.
PORT=9703
# Secret used to sign session cookies. Change in production.
# If unset or empty, the api falls back to an insecure dev secret (with a warning).
SESSION_SECRET=change-me-in-production
# Set to 'true' once the stack is served over HTTPS so session cookies get the Secure flag.
# Leave 'false' for plain-http / behind-nginx-on-http development (the default).
COOKIE_SECURE=false
# Internal api port — consumed only inside the api container; the api is NOT published
# to the host (nginx proxies to api:3000 on the compose network). Left at its default;
# override only if you also change the nginx proxy_pass target.
# APP_PORT=3000
