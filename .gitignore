# Dependencies
node_modules/
**/node_modules/

# Build output / caches
**/dist/
**/build/
*.tsbuildinfo
.vite/
# Coverage reports (report-only; generated by node:test / vitest --coverage)
**/coverage/

# Runtime data & config (operator-provided, not committed)
audio/*
settings.json
# SQLite database + transient sidecars (keep data/.gitkeep tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/branding
.env
.env.*
!.env.example

# Agent / workflow artifacts & worktrees
.agents/
.worktrees/

# Portable, uncommitted notes meant to be copied into other projects (never committed here)
PORTABLE-*.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
